---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { SITE } from '../config';
import interRegularUrl from '../assets/fonts/Inter-Regular.woff?url';
import interBoldUrl from '../assets/fonts/Inter-Bold.woff?url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.labName}` : `${SITE.labName} - ${SITE.university}`;

// Dynamic OG Image mapping
const currentPath = Astro.url.pathname.replace(/^\/|\/$/g, '');
const ogSlug = currentPath === '' ? 'index' : currentPath;
const supportedOgPages = ['index', 'research', 'publications', 'patents', 'equipment', 'team', 'news', 'join'];
const finalOgSlug = supportedOgPages.includes(ogSlug) ? ogSlug : 'index';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${basePath}/og/${finalOgSlug}.png`, Astro.url);
// Canonical URL — SITE.website must be updated when the site moves to biosensorslab.iitd.ac.in
const canonicalURL = new URL(Astro.url.pathname, SITE.website).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self';" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={basePath + '/favicon.svg'} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Self-hosted Inter font: preload (@font-face lives in src/styles/global.css) -->
    <link rel="preload" href={interRegularUrl} as="font" type="font/woff" crossorigin />
    <link rel="preload" href={interBoldUrl} as="font" type="font/woff" crossorigin />

    <title>{pageTitle}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    {
      Astro.url.pathname === '/' && (
        <>
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "ResearchOrganization",
          "name": SITE.labName,
          "url": SITE.website,
          "logo": new URL(basePath + SITE.logo, SITE.website).href,
          "description": SITE.description,
          "parentOrganization": {
            "@type": "CollegeOrDepartment",
            "name": "Centre for Biomedical Engineering (CBME)",
            "parentOrganization": {
              "@type": "CollegeOrUniversity",
              "name": "Indian Institute of Technology Delhi",
              "url": "https://iitd.ac.in/"
            }
          },
          "email": SITE.email,
          "member": {
            "@type": "Person",
            "name": SITE.author,
            "jobTitle": "Principal Investigator",
            "worksFor": {
              "@type": "ResearchOrganization",
              "name": SITE.labName,
              "url": SITE.website
            }
          }
        })} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Person",
          "name": SITE.author,
          "url": SITE.website,
          "jobTitle": "Principal Investigator",
          "worksFor": {
            "@type": "ResearchOrganization",
            "name": SITE.labName,
            "url": SITE.website
          },
          "description": SITE.description
        })} />
        </>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:bg-blue-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">Skip to content</a>
    <Header />
    <main id="main-content" class="flex-grow" data-pagefind-body>
      <slot />
    </main>

    <footer class="border-t border-gray-100 py-10 mt-12 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="text-center md:text-left">
            <p class="font-semibold text-gray-800 text-sm">
              {SITE.labName} · {SITE.university}
            </p>
            <p class="text-gray-500 text-sm mt-1">
              Centre for Biomedical Engineering, Indian Institute of Technology Delhi, Hauz Khas, New Delhi 110016, India · Room GPL-9 (lab relocating soon)
            </p>
            <p class="text-gray-500 text-sm mt-1">
              Principal Investigator: Dr. Naveen Kumar Singh · <a href={`mailto:${SITE.email}`} class="hover:text-blue-600 transition-colors">{SITE.email}</a>
            </p>
          </div>
          <div class="text-center md:text-right text-sm text-gray-500 shrink-0">
            <p>© {new Date().getFullYear()} {SITE.labName}. All rights reserved.</p>
            <p class="mt-1">
              <a href="https://github.com/fjd2004711/scholar-lite" target="_blank" rel="noopener noreferrer" class="hover:text-gray-700 transition-colors">
                Built with Scholar-Lite
              </a>
            </p>
          </div>
        </div>
      </div>
    </footer>

    <!-- Scroll-reveal driver: adds .is-visible to [data-reveal] as they enter the viewport.
         No-op when JS is unavailable or reduced-motion is preferred (CSS guard handles both). -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                io.unobserve(en.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -32px 0px' }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>