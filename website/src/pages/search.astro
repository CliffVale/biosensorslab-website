---
import Layout from '../layouts/Layout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagefindConfig = JSON.stringify({
  element: "#search",
  showSubResults: true,
  pageSize: 10,
  showImages: false,
  baseUrl: basePath + '/',
});
export const prerender = true;
---

<Layout title="Search" description="Search the Biosensors & Devices Lab website.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 min-h-[60vh]">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Search</h1>
      <p class="text-gray-600">Search through our publications, news, research, and team members.</p>
    </div>
    
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
      <div id="search" class="w-full"></div>
    </div>
  </div>
  
  <div id="pagefind-config" data-config={pagefindConfig} class="hidden"></div>
  <link href={basePath + '/pagefind/pagefind-ui.css'} rel="stylesheet">
  <script src={basePath + '/pagefind/pagefind-ui.js'} is:inline></script>
  <script is:inline>
    function initPagefind() {
      if (typeof window.PagefindUI !== 'function') return;
      const el = document.querySelector("#search");
      if (!el) return;
      el.innerHTML = ''; // Clear existing
      const cfgEl = document.getElementById('pagefind-config');
      const cfg = cfgEl ? JSON.parse(cfgEl.dataset.config) : { element: '#search' };
      new PagefindUI(cfg);
    }

    window.addEventListener('DOMContentLoaded', initPagefind);
  </script>
  
  <style is:global>
    @reference "tailwindcss";
    
    /* Custom styling for Pagefind */
    .pagefind-ui__search-input {
      @apply rounded-lg border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500;
    }
    .pagefind-ui__drawer {
      @apply gap-4;
    }
    .pagefind-ui__result {
      @apply border-b border-gray-100 py-4 last:border-0;
    }
    .pagefind-ui__result-title {
      @apply font-semibold text-blue-600 hover:underline;
    }
    .pagefind-ui__result-excerpt {
      @apply text-gray-600 text-sm mt-1;
    }
    .pagefind-ui__message {
      @apply text-gray-500 text-center py-4;
    }
  </style>
</Layout>