---
import Layout from '../layouts/Layout.astro';
import { GraduationCap, BookOpen, CalendarDays } from 'lucide-react';

const courses = [
  { code: 'BML 8860', title: 'Fundamentals of Electrochemistry for Clinical Applications', note: 'New course offering' },
  { code: 'BML 800', title: 'Biosensors & Bioinstrumentation', note: 'Core course for biosensors track' },
  { code: 'BML 830', title: 'Advanced Biomedical Instrumentation', note: '' },
  { code: 'BMV 703', title: 'Biomedical Devices & Instrumentation', note: '' },
  { code: 'BML 890', title: 'Seminar', note: '' },
  { code: 'BMP 743', title: 'Master\'s Project / Dissertation', note: '' },
];
---

<Layout
  title="Courses"
  description="Courses taught by Dr. Naveen Kumar Singh at the Centre for Biomedical Engineering, IIT Delhi."
>
  <section class="py-14 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 sm:mb-14">
        <div class="flex items-center gap-3 mb-3">
          <GraduationCap className="w-8 h-8 text-blue-700" />
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">Courses</h1>
        </div>
        <p class="mt-2 text-gray-600 text-base sm:text-lg">
          Courses offered by the lab through the Centre for Biomedical Engineering (CBME), IIT Delhi.
        </p>
      </div>

      <div class="space-y-4">
        {courses.map(c => (
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow p-5 sm:p-6 flex items-start gap-4">
            <div class="shrink-0 w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center">
              <BookOpen className="w-5 h-5 text-blue-700" />
            </div>
            <div>
              <p class="text-xs font-mono font-semibold text-blue-700">{c.code}</p>
              <h3 class="font-semibold text-gray-900">{c.title}</h3>
              {c.note && <p class="text-sm text-gray-500 mt-1">{c.note}</p>}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 bg-gray-50 rounded-2xl p-6 flex items-start gap-3">
        <CalendarDays className="w-5 h-5 text-gray-500 mt-0.5" />
        <p class="text-sm text-gray-600">
          Course offerings and schedules vary by semester. Please contact
          <a href="mailto:nks@iitd.ac.in" class="text-blue-700 underline mx-1">nks@iitd.ac.in</a>
          or check the CBME department page for the current semester's course list.
        </p>
      </div>
    </div>
  </section>
</Layout>
