---
import Layout from '../layouts/Layout.astro';
import { Mail, Phone, MapPin, Clock } from 'lucide-react';
---

<Layout
  title="Contact Us"
  description="Contact the Biosensors & Devices Lab at IIT Delhi."
>
  <section class="py-14 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Contact Us</h1>
      <p class="text-gray-600 mb-10">We welcome collaboration enquiries, student applications, and academic visitors.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
          <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-4">
            <Mail className="w-5 h-5 text-blue-700" />
          </div>
          <h2 class="font-semibold text-gray-900 mb-1">Email</h2>
          <a href="mailto:nks@iitd.ac.in" class="text-blue-700 hover:underline">nks@iitd.ac.in</a>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
          <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-4">
            <Phone className="w-5 h-5 text-blue-700" />
          </div>
          <h2 class="font-semibold text-gray-900 mb-1">Phone</h2>
          <p class="text-gray-700">+91 11 2659 1152</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 sm:col-span-2">
          <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-4">
            <MapPin className="w-5 h-5 text-blue-700" />
          </div>
          <h2 class="font-semibold text-gray-900 mb-1">Address</h2>
          <p class="text-gray-700 leading-relaxed">
            Biosensors &amp; Devices Lab<br />
            Centre for Biomedical Engineering<br />
            Indian Institute of Technology Delhi<br />
            Hauz Khas, New Delhi 110016, India
          </p>
          <p class="mt-2 text-sm text-gray-500">Room GPL-9 (lab relocating — please confirm current location by email).</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 sm:col-span-2">
          <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-4">
            <Clock className="w-5 h-5 text-blue-700" />
          </div>
          <h2 class="font-semibold text-gray-900 mb-1">Visiting</h2>
          <p class="text-gray-700 text-sm">
            Prospective students and collaborators are encouraged to email before visiting.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
